# =====================================================================
# Search Engine Simulation Experiment (Geometric Distribution)
# =====================================================================

run_search_simulation <- function() {
  # --- PROGRAM RULES & INSTRUCTIONS DISPLAYED IN CONSOLE ---
  cat("\n=========================================================\n")
  cat("           SEARCH ENGINE SIMULATION EXPERIMENT           \n")
  cat("=========================================================\n")
  cat("Rules & Execution Guidelines:\n")
  cat("1. Must be run in an interactive R console session.\n")
  cat("2. Input probability 'p' must be within the interval (0, 1].\n")
  cat("3. Generates 10,000 Monte Carlo simulation trials.\n")
  cat("4. Verifies the memoryless property of the Geometric distribution.\n")
  cat("=========================================================\n\n")
  
  # Input probability p with default test data 0.60 (60%)
  p_input <- readline(prompt = "Enter probability p that a site contains the key phrase (default 0.60): ")
  p <- if (p_input == "") 0.60 else as.numeric(p_input)
  
  if (is.na(p) || p <= 0 || p > 1) {
    stop("Error: Probability p must be within the interval (0, 1].")
  }
  
  N <- 10000
  set.seed(42) # Ensure reproducibility
  
  # Simulate X: number of searches to the first success (Geometric distribution)
  X <- rgeom(N, p) + 1
  
  # --- Task 1: Complete Set Statistics & PMF/PDF Plot ---
  mean_X <- mean(X)
  var_X <- var(X)
  
  cat("\n=========================================\n")
  cat(sprintf("1. COMPLETE SET STATISTICS (p = %.2f)\n", p))
  cat("=========================================\n")
  cat(sprintf("Simulated Mean:     %.4f (Theoretical: %.4f)\n", mean_X, 1/p))
  cat(sprintf("Simulated Variance: %.4f (Theoretical: %.4f)\n", var_X, (1-p)/(p^2)))
  
  # Plot simulated PDF (PMF)
  dev.new()
  barplot(table(X) / N, 
          main = sprintf("Simulated PDF of X (p = %.2f)", p),
          xlab = "Number of Searches (X)", 
          ylab = "Probability", 
          col = "steelblue", border = "black")
  
  # --- Task 2: Conditional Distribution given X > 3 ---
  X_gt_3 <- X[X > 3]
  X_remaining <- X_gt_3 - 3
  
  mean_cond <- mean(X_remaining)
  var_cond <- var(X_remaining)
  
  cat("\n=========================================\n")
  cat("2. CONDITIONAL DISTRIBUTION (X - 3 | X > 3)\n")
  cat("=========================================\n")
  cat(sprintf("Conditional Mean:     %.4f (Complete Set Mean: %.4f)\n", mean_cond, mean_X))
  cat(sprintf("Conditional Variance: %.4f (Complete Set Variance: %.4f)\n", var_cond, var_X))
  
  # --- Task 3: Markov Memoryless Property Verification ---
  p_cond_4 <- sum(X == 4) / sum(X > 3)
  p_1 <- mean(X == 1)
  
  p_cond_5 <- sum(X == 5) / sum(X > 3)
  p_2 <- mean(X == 2)
  
  cat("\n=========================================\n")
  cat("3. MARKOV MEMORYLESS PROPERTY ESTIMATES\n")
  cat("=========================================\n")
  cat(sprintf("1. P(X = 4 | X > 3) = %.4f  |  P(X = 1) = %.4f\n", p_cond_4, p_1))
  cat(sprintf("2. P(X = 5 | X > 3) = %.4f  |  P(X = 2) = %.4f\n", p_cond_5, p_2))
  cat("-----------------------------------------\n")
  cat("Observation: The conditional probabilities match the baseline\n")
  cat("probabilities, verifying the memoryless property.\n")
}

# Run command: run_search_simulation()
